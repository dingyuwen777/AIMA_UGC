# Internal V1-A 服务器非敏感运行配置模板。
# 真实文件建议保存到 /data/AIMA_UGC/shared/env/aima.env；不要把 Secret 写进本文件。

AIMA_IMAGE_TAG=internal-v1a
AIMA_HTTP_BIND_IP=127.0.0.1
AIMA_HTTP_PORT=8080

AIMA_HOST_DATA_DIR=/data/AIMA_UGC/runtime/data
AIMA_HOST_LOG_DIR=/data/AIMA_UGC/runtime/logs
AIMA_HOST_POSTGRES_DIR=/data/AIMA_UGC/postgres
AIMA_HOST_SECRET_DIR=/data/AIMA_UGC/shared/secrets

AIMA_DB_NAME=aima_ugc
AIMA_DB_USER=aima_ugc
AIMA_DB_CONNECT_TIMEOUT_SECONDS=5

AIMA_LOG_LEVEL=INFO
AIMA_LOG_MAX_BYTES=20971520
AIMA_LOG_BACKUP_COUNT=10
AIMA_LOG_COMPRESS=true

# TikHub 默认禁用。启用前由管理员把 API Key 写入 Secret 目录的 tikhub_api_key。
AIMA_TIKHUB_ENABLED=false
AIMA_TIKHUB_BASE_URL=https://api.tikhub.io
AIMA_TIKHUB_SECRET_REF=tikhub_api_key

# LLM 完全可选。只有启用 AI 时取消下列注释，并同时提供 Secret 文件 llm_api_key。
# AIMA_LLM_BASE_URL=https://provider.example/v1
# AIMA_LLM_PROVIDER_NAME=provider-name
# AIMA_LLM_MODEL=model-name
