# Internal V1 / Production-like Compose 配置模板。
#
# Linux / WSL / 公司服务器：
#   cp env.production.example env.production
#   chmod 0600 env.production
#   编辑 env.production 后运行：
#   docker compose --env-file env.production up -d --build --wait
#
# Windows Docker Desktop（CMD / PowerShell）：
#   首次运行 scripts\dev\compose_windows.cmd 或 compose_windows.ps1 会生成 env.production；
#   编辑同一个 env.production 后，再次执行同一个脚本即可启动完整容器 Runtime。
#   Windows 原生模式用 compose.windows.yaml 把持久状态放入 Docker-managed named volumes，
#   不把 PostgreSQL / 内部 Secret 直接 bind mount 到 NTFS。
#
# 同一份字段结构同时用于：
# - 本地源码之外的完整 Docker Runtime；
# - 公司服务器 Internal V1；
# - 后续正式 Production Release 的 Runtime 配置。
#
# 真实 env.production 包含 TikHub/LLM API Key，属于敏感文件：
# - 已由 .gitignore 忽略；
# - 不要提交 Git、打入 Release/镜像、粘贴到日志或工单；
# - PostgreSQL 密码和 Cursor signing keys 不在这里配置，由 AIMA 首次启动自动生成并持久保存。

AIMA_IMAGE_TAG=internal-v1a
AIMA_HTTP_BIND_IP=127.0.0.1
AIMA_HTTP_PORT=8080

# 构建/镜像下载源。
# 中国网络环境默认使用国内镜像代理与软件包镜像；版本号保持仓库锁定值，不使用 latest。
# 这些变量只影响 build/pull，不进入 AIMA 业务 Runtime Contract。
AIMA_BUILD_PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.14.7-slim-trixie
AIMA_BUILD_UV_IMAGE=m.daocloud.io/ghcr.io/astral-sh/uv:0.12.3
AIMA_BUILD_NODE_IMAGE=m.daocloud.io/docker.io/library/node:24.19.0-bookworm-slim
AIMA_BUILD_NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.30.4-alpine3.24
AIMA_POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:18.4
AIMA_BUILD_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
AIMA_BUILD_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
AIMA_BUILD_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
AIMA_BUILD_NPM_REGISTRY=https://registry.npmmirror.com

# 如果构建机不在中国或国内镜像不可用，可改回官方源；业务配置和持久数据不需要变化：
# AIMA_BUILD_PYTHON_IMAGE=python:3.14.7-slim-trixie
# AIMA_BUILD_UV_IMAGE=ghcr.io/astral-sh/uv:0.12.3
# AIMA_BUILD_NODE_IMAGE=node:24.19.0-bookworm-slim
# AIMA_BUILD_NGINX_IMAGE=nginx:1.30.4-alpine3.24
# AIMA_POSTGRES_IMAGE=postgres:18.4
# AIMA_BUILD_DEBIAN_MIRROR=http://deb.debian.org/debian
# AIMA_BUILD_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# AIMA_BUILD_PYPI_INDEX=https://pypi.org/simple
# AIMA_BUILD_NPM_REGISTRY=https://registry.npmjs.org

# Linux / WSL / 公司服务器的宿主持久化根目录。
# 服务器推荐保持 /data/AIMA_UGC，使数据库、Artifact、日志和内部 Secret 与 Release 生命周期解耦。
# Linux / WSL 本地完整 Compose 可在本机改为：AIMA_HOST_ROOT=./.runtime/compose
# Windows Docker Desktop 原生 CMD / PowerShell 启动时，compose.windows.yaml 会用 Docker named volumes
# 替换这四类持久 bind mount；本字段仍保留相同配置 Schema，但不会成为 Windows 持久数据位置。
AIMA_HOST_ROOT=/data/AIMA_UGC

AIMA_DB_NAME=aima_ugc
AIMA_DB_USER=aima_ugc
AIMA_DB_CONNECT_TIMEOUT_SECONDS=5

AIMA_LOG_LEVEL=INFO
AIMA_LOG_MAX_BYTES=20971520
AIMA_LOG_BACKUP_COUNT=10
AIMA_LOG_COMPRESS=true

# TikHub 默认禁用。启用时改为 true 并填写 API Key。
# API Key 由 Compose 转成 /run/secrets/tikhub_api_key，不作为业务容器环境变量传入。
AIMA_TIKHUB_ENABLED=false
AIMA_TIKHUB_BASE_URL=https://api.tikhub.io
AIMA_TIKHUB_API_KEY=

# LLM 完全可选。启用 AI 时填写 API Key，并取消下面 Runtime 三项的注释。
# API Key 由 Compose 转成 /run/secrets/llm_api_key，不作为业务容器环境变量传入。
AIMA_LLM_API_KEY=
# AIMA_LLM_BASE_URL=https://provider.example/v1
# AIMA_LLM_PROVIDER_NAME=provider-name
# AIMA_LLM_MODEL=model-name