# 复制为 .env 后填写真实值；.env 已被仓库根 .gitignore 忽略，禁止提交真实密钥。
# 必填：OpenAI-compatible API 根地址；从模型供应商官方 API 文档查看。
# DeepSeek 官方 OpenAI 格式地址：https://api.deepseek.com
AIMA_LLM_BASE_URL=

# 必填：真实 API key；从模型供应商控制台创建。该值是 Secret，禁止提交。
AIMA_LLM_API_KEY=

# 必填：请求中的精确模型名称；从供应商官方模型/价格页面查看。
# DeepSeek 当前示例：deepseek-v4-pro
AIMA_LLM_MODEL=

# 可选：单次 HTTP 请求超时秒数；不配置时使用 Adapter 默认 60 秒。
# AIMA_LLM_TIMEOUT_SECONDS=60

# 这里不配置单价、生效时间或价格版本。
# token 单价在 adapters/llm/pricing.toml 维护，来源必须是供应商官方价格页；
# 每次 HTTP 请求会把实际使用的单价和自动生成的价格快照 SHA-256 写入 run 审计。
