{
  "name": "aima-ugc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "orval --config orval.config.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:ts7 && npm run typecheck:vue",
    "typecheck:ts7": "node ./node_modules/@typescript/native/lib/tsc.js --project tsconfig.native.json --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "test": "vitest",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "element-plus": "2.14.4",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "orval": "8.24.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  }
}
