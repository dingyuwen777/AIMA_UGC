replace_once(
    excel,
    '''def _markdown_cell(value: object) -> str:
    if value is None:
        return ""
    text = str(value)
    return text.replace("\\\\", "\\\\\\\\").replace("|", "\\\\|").replace("\\n", "<br>")
''',
    '''def _markdown_cell(value: object) -> str:
    if value is None:
        return ""
    text = f"{value:,}" if isinstance(value, int) and not isinstance(value, bool) else str(value)
    return text.replace("\\\\", "\\\\\\\\").replace("|", "\\\\|").replace("\\n", "<br>")
''',
)

