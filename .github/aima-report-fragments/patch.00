from __future__ import annotations

from pathlib import Path

ROOT = Path.cwd()


def replace_once(path: Path, old: str, new: str) -> None:
    text = path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f"{path}: 期望精确匹配 1 次，实际 {count} 次")
    path.write_text(text.replace(old, new), encoding="utf-8")


def replace_all_expected(path: Path, old: str, new: str, expected: int) -> None:
    text = path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != expected:
        raise RuntimeError(f"{path}: 期望匹配 {expected} 次，实际 {count} 次")
    path.write_text(text.replace(old, new), encoding="utf-8")


excel = ROOT / "backend/src/aima_ugc/platform/reporting/excel_report.py"
