new_png = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4//8/AAX+Av4N70a4AAAAAElFTkSuQmCC"
test_docx = ROOT / "tests/unit/platform/test_docx_package_structure.py"
text = test_docx.read_text(encoding="utf-8")
