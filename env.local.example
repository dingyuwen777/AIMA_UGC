# AIMA_UGC 本地统一配置模板。
#
# 同一份 env.local 同时服务两种本地运行方式：
#
# 1. 源码开发 / 热更新：
#      uv run python scripts/dev/backend.py
#      uv run python scripts/dev/frontend.py
#
# 2. 本地完整 Docker Runtime：
#      Linux / WSL:
#        docker compose --env-file env.local up -d --build --wait
#      Windows Docker Desktop:
#        docker compose -f compose.yaml -f compose.windows.yaml --env-file env.local up -d --build --wait
#
# 源码 launcher 只消费与源码运行有关的字段；Docker-only 字段属于合法共享配置，
# 不会被误报为 unknown，也不会被透传进源码 API/Worker/Scheduler 进程。
# env.local 不存在时源码 launcher 会自动从本文件复制；如果直接使用 Compose，
# 请先手工复制：cp env.local.example env.local（Windows 可使用 copy / Copy-Item）。
# 真实 env.local 已被 Git 忽略，不要提交 API Key。

# ------------------------------------------------------------
# 本地 Docker Runtime
# ------------------------------------------------------------
AIMA_IMAGE_TAG=internal-v1a
AIMA_HTTP_BIND_IP=127.0.0.1
AIMA_HTTP_PORT=8080

# Docker Compose 内部 app bridge 网络。
# 如与本机 LAN / VPN / 其他 Docker network 冲突，subnet 与 gateway 必须成对修改。
AIMA_DOCKER_SUBNET=10.1.1.0/24
AIMA_DOCKER_GATEWAY=10.1.1.1

# 只改变构建下载源，不改变依赖版本、lockfile 或镜像 tag。
AIMA_BUILD_DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
AIMA_BUILD_DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
AIMA_BUILD_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
AIMA_BUILD_NPM_REGISTRY=https://registry.npmmirror.com

# 本地完整 Compose 的宿主持久化根。源码 launcher 不使用该值，
# 仍保持自己的 .runtime/data、.runtime/logs 和本地 PostgreSQL named volume。
AIMA_HOST_ROOT=./.runtime/compose

# ------------------------------------------------------------
# 统一数据导入：宿主路径与运行时路径
# ------------------------------------------------------------
# HOST_ROOT 是宿主文件系统真实目录：
# - 源码 launcher 优先把它作为 API/Worker 能访问的历史导入根；
# - Compose 把它作为只读 bind mount source。
AIMA_HISTORICAL_IMPORT_HOST_ROOT=./.runtime/historical-input

# ROOT 是 Docker 容器内 API/Worker 看见的 bind mount target。
# 源码 launcher 在 HOST_ROOT 存在时不会把这个容器路径传给本地进程；
# 旧 env.local 只有 ROOT=.runtime/... 时仍保留源码兼容回退。
AIMA_HISTORICAL_IMPORT_ROOT=/data/aima-historical-input
AIMA_HISTORICAL_CHUNK_ROWS=1000
AIMA_HISTORICAL_MAX_SCAN_FILES=10000
AIMA_HISTORICAL_MAX_DIRECTORY_DEPTH=8
AIMA_HISTORICAL_MAX_IN_FLIGHT_JOBS=2

# Analysis Run 队列窗口；Shard Size 由 Provider max_concurrency 自动计算，不在这里配置。
AIMA_ANALYSIS_RUN_MAX_IN_FLIGHT_JOBS=2

# 本地 Compose 数据库/日志非敏感参数；源码 launcher 使用自己的固定开发数据库边界。
AIMA_DB_NAME=aima_ugc
AIMA_DB_USER=aima_ugc
AIMA_DB_CONNECT_TIMEOUT_SECONDS=5
AIMA_LOG_LEVEL=INFO
AIMA_LOG_MAX_BYTES=20971520
AIMA_LOG_BACKUP_COUNT=10
AIMA_LOG_COMPRESS=true

# ------------------------------------------------------------
# TikHub（可选）
# ------------------------------------------------------------
# 源码 launcher：填写 API Key 即幂等启用自己的 TikHub Local Dev Provider Config。
# Docker Compose：同时把 AIMA_TIKHUB_ENABLED 改为 true。
# 两种方式都不会把真实 Key 保存到 PostgreSQL。
AIMA_TIKHUB_ENABLED=false
AIMA_TIKHUB_BASE_URL=https://api.tikhub.io
AIMA_TIKHUB_API_KEY=

# ------------------------------------------------------------
# AI / LLM（可选）
# ------------------------------------------------------------
# 只有需要执行真实 AI 打标时填写。源码 launcher 会把 API Key 写入
# .runtime/secrets/llm_api_key；Compose 使用 Compose Secret。
AIMA_LLM_BASE_URL=https://api.deepseek.com
AIMA_LLM_PROVIDER_NAME=api.deepseek.com
AIMA_LLM_MODEL=deepseek-v4-pro
AIMA_LLM_API_KEY=

# ------------------------------------------------------------
# 源码开发专用
# ------------------------------------------------------------
# 默认关闭，避免本地数据库中残留的 enabled Plan 在启动开发环境时意外产生付费采集。
# Docker Compose 的 Scheduler 是正式 Runtime 服务，不读取该字段。
AIMA_DEV_ENABLE_SCHEDULER=false
