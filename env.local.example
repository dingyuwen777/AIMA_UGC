# AIMA_UGC 本地统一配置模板。
#
# 同一份 env.local 同时服务两种本地运行方式：
#
# 1. 源码开发 / 热更新：
#      uv run python scripts/dev/backend.py
#      uv run python scripts/dev/frontend.py
#
# 2. 本地完整 Docker Runtime：
#      Linux / WSL:
#        docker compose --env-file env.local up -d --build --wait
#      Windows Docker Desktop:
#        docker compose -f compose.yaml -f compose.windows.yaml --env-file env.local up -d --build --wait
#
# 源码 launcher 只消费与源码运行有关的字段；Docker-only 字段属于合法共享配置，
# 不会被误报为 unknown，也不会被透传进源码 API/Worker/Scheduler 进程。
# env.local 不存在时源码 launcher 会自动从本文件复制；如果直接使用 Compose，
# 请先手工复制：cp env.local.example env.local（Windows 可使用 copy / Copy-Item）。
# 真实 env.local 已被 Git 忽略，不要提交 API Key。
#
# 本文件中的环境变量都是“进程/容器启动输入”，不是热更新配置：
# - 修改源码运行相关字段后，重启对应源码进程；
# - 修改 Compose 运行相关字段后，用上述 Compose 命令重新创建/启动受影响服务。
# 某些任务会在创建时冻结运行事实（下文会单独说明）；修改 env 不会改写已经冻结的事实。
# 模板中的数值是当前安全默认值/背压起点，不代表硬件、数据库或外部 Provider 的最大能力。

# ------------------------------------------------------------
# 本地 Docker Runtime：镜像、监听与容器网络
# ------------------------------------------------------------
# 只决定本地 Compose 使用的镜像 tag、宿主监听地址和宿主端口；不控制业务并发。
AIMA_IMAGE_TAG=internal-v1a
AIMA_HTTP_BIND_IP=127.0.0.1
AIMA_HTTP_PORT=8080

# Docker Compose 内部 app bridge 网络。
# 这里只定义容器网络 IPAM，不给业务容器绑定固定 IP，也不是业务吞吐/容量上限。
# 如与本机 LAN / VPN / 其他 Docker network 冲突，subnet 与 gateway 必须成对修改。
AIMA_DOCKER_SUBNET=10.1.1.0/24
AIMA_DOCKER_GATEWAY=10.1.1.1

# 仅改变镜像构建时的下载源，不改变依赖版本、lockfile、镜像 tag 或运行时行为。
AIMA_BUILD_DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
AIMA_BUILD_DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
AIMA_BUILD_PYPI_INDEX=https://pypi.org/simple
AIMA_BUILD_NPM_REGISTRY=https://registry.npmmirror.com

# 本地完整 Compose 的宿主持久化根。源码 launcher 不使用该值，
# 仍保持自己的 .runtime/data、.runtime/logs 和本地 PostgreSQL named volume。
AIMA_HOST_ROOT=./.runtime/compose

# ------------------------------------------------------------
# 统一数据导入：路径、安全护栏与 Job 背压
# ------------------------------------------------------------
# HOST_ROOT 是宿主文件系统真实目录：
# - 源码 launcher 优先把它作为 API/Worker 能访问的历史导入根；
# - Compose 把它作为只读 bind mount source。
AIMA_HISTORICAL_IMPORT_HOST_ROOT=./.runtime/historical-input

# ROOT 是 Docker 容器内 API/Worker 看见的 bind mount target。
# 源码 launcher 在 HOST_ROOT 存在时不会把这个容器路径传给本地进程；
# 旧 env.local 只有 ROOT=.runtime/... 时仍保留源码兼容回退。
AIMA_HISTORICAL_IMPORT_ROOT=/data/aima-historical-input

# 以下四项是完整 Compose Runtime 的导入调度参数；源码 launcher 会识别但不会透传，
# 因而源码运行继续使用当前代码默认值。它们都不是“系统最多只能处理多少数据”的总容量上限。
#
# Chunk Rows：每个新 Data Import Campaign 创建时冻结到 profile_snapshot 的 Chunk 粒度。
# 当前 Settings 接受 100—2000；1000 是默认事务/恢复粒度，不是总导入行数上限。
# 修改后只影响之后创建的 Campaign，不能重切已经冻结的 Campaign Chunk。
AIMA_HISTORICAL_CHUNK_ROWS=1000

# Server Path Discover 安全护栏：限制一次递归发现允许纳入的 XLSX 文件数和目录深度。
# 当前 Settings 分别接受 1—100000 与 1—32；实际目录超过配置阈值时 Discover 会失败关闭，
# 以避免误扫大型共享盘或异常目录树。它们不是导入完成后的数据库容量限制。
AIMA_HISTORICAL_MAX_SCAN_FILES=10000
AIMA_HISTORICAL_MAX_DIRECTORY_DEPTH=8

# Historical Job 背压窗口：限制同一 Campaign 同时处于未完成调度状态的 Snapshot/Chunk Job 数。
# 当前 Settings 接受 1—16。它控制 Job 表积压和资源压力，不承诺相同数量的物理 Worker 并发；
# 当前 Compose 只有一个 Worker 服务时，单纯把该值调到最大不会线性提高导入吞吐。
# 修改 env 并重新创建 Worker/API 后，后续调度读取新的 Runtime 值；已冻结 Chunk 本身不改变。
AIMA_HISTORICAL_MAX_IN_FLIGHT_JOBS=2

# ------------------------------------------------------------
# Analysis Run：Shard Job 背压
# ------------------------------------------------------------
# 这里只配置 Analysis Shard 的 queued/running Job 窗口，当前 Settings 接受 1—16。
# 它不是 LLM 请求并发，也不是模型吞吐上限：一个 Shard 内的实际并发来自该 Run 冻结的
# Provider max_concurrency；可选 max_rps 也随 Provider Snapshot 冻结。
# Shard Size 由 Provider max_concurrency / max_rps 自动推导并在创建 Run 时冻结，不在 env 配置。
# 修改本值并重新创建 Worker 后只改变后续 Shard 调度窗口，不会改写已有 Run 冻结的 Provider/Shard Size。
AIMA_ANALYSIS_RUN_MAX_IN_FLIGHT_JOBS=2

# ------------------------------------------------------------
# PostgreSQL 与日志
# ------------------------------------------------------------
# 本地 Compose 数据库/日志非敏感参数；源码 launcher 使用自己的固定开发数据库边界。
AIMA_DB_NAME=aima_ugc
AIMA_DB_USER=aima_ugc

# 只限制建立 PostgreSQL 连接时的等待时间，不是 SQL 查询、事务或 Job 执行超时。
AIMA_DB_CONNECT_TIMEOUT_SECONDS=5

# 日志级别与文件轮转/保留策略；限制的是日志文件资源，不限制业务处理能力。
AIMA_LOG_LEVEL=INFO
AIMA_LOG_MAX_BYTES=20971520
AIMA_LOG_BACKUP_COUNT=10
AIMA_LOG_COMPRESS=true

# ------------------------------------------------------------
# TikHub（可选能力，模板默认启用）
# ------------------------------------------------------------
# 模板默认 AIMA_TIKHUB_ENABLED=true。
# 源码 launcher 不读取该开关，仍以 AIMA_TIKHUB_API_KEY 是否非空判断本地 TikHub 是否可用；
# Key 为空时源码开发仍可启动，并把 TikHub 显示为 NOT CONFIGURED。
# 完整 Docker Compose 在数据库尚未接管 TikHub Provider 时会按 enabled=true 做首次装配，
# 因此启动前必须填写 AIMA_TIKHUB_API_KEY；Key 为空会 fail closed，而不是静默降级。
# 数据库中稳定 TikHub Provider 已存在后，后续启停和非敏感配置由管理员控制面维护，env 不覆盖它。
# 两种方式都不会把真实 Key 保存到 PostgreSQL；Compose 把 Key 转成 Secret 文件。
AIMA_TIKHUB_ENABLED=true
AIMA_TIKHUB_BASE_URL=https://api.tikhub.io
AIMA_TIKHUB_API_KEY=

# ------------------------------------------------------------
# AI / LLM（可选能力，模板默认启用）
# ------------------------------------------------------------
# Base URL / Provider Name / Model 默认作为 Runtime 启动输入存在；模板仍不会保存真实 API Key。
# 源码 launcher 只有在 Base URL + Model + API Key 完整时才把 LLM 配置传给 Worker；
# Key 为空时源码开发仍可启动，并把 AI Analysis 显示为 NOT CONFIGURED。
# 完整 Docker Compose 在数据库尚未存在任何 LLM Provider 时会使用 env 做首次装配/兼容 fallback，
# 因此启动前必须填写 AIMA_LLM_API_KEY；Key 为空会 fail closed，而不是把半配置视为可用。
# 一旦管理员创建过任意 LLM Provider，数据库就是唯一运行时事实源，禁用/无默认项也不会回退 env。
# 正式吞吐容量请在管理员 Provider 中配置 max_concurrency / max_rps；本模板不再提供平行的
# AIMA_LLM_MAX_CONNECTIONS 调优入口，避免 env 与数据库形成两套生产容量事实。
AIMA_LLM_BASE_URL=https://api.deepseek.com
AIMA_LLM_PROVIDER_NAME=api.deepseek.com
AIMA_LLM_MODEL=deepseek-v4-pro
AIMA_LLM_API_KEY=

# ------------------------------------------------------------
# 源码开发专用
# ------------------------------------------------------------
# 默认关闭，避免本地数据库中残留的 enabled Plan 在启动源码开发环境时意外产生付费采集。
# 该字段只由源码 launcher 消费；Docker Compose 的 Scheduler 是独立正式 Runtime 服务，不读取它。
AIMA_DEV_ENABLE_SCHEDULER=false
