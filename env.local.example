# AIMA_UGC 本地源码调试可选配置。
#
# 日常启动只需要：
#   uv run python scripts/dev/backend.py
#   uv run python scripts/dev/frontend.py
#
# PostgreSQL、数据库密码、.runtime 目录、Cursor signing key、Migration、
# API/Worker 启动参数都由 dev launcher 自动准备，不需要在这里配置。
#
# env.local 不存在时会自动从本文件复制；真实 env.local 已被 Git 忽略。
# 不配置 TikHub / LLM 也可以正常使用 Excel 导入、声音广场和 Excel 导出。

# ------------------------------------------------------------
# TikHub（可选）
# ------------------------------------------------------------
# 只有需要从前端执行真实 TikHub Discovery / Batch Supplement 时填写 API Key。
# dev launcher 会把 Key 写入 .runtime/secrets/tikhub_api_key，
# PostgreSQL Provider Config 只保存 secret_ref，不保存真实 Key。
AIMA_TIKHUB_BASE_URL=https://api.tikhub.io
AIMA_TIKHUB_API_KEY=

# ------------------------------------------------------------
# AI / LLM（可选）
# ------------------------------------------------------------
# 只有需要从声音广场执行真实 AI 打标时填写。
# Provider Name 可以留空，由 OpenAI-compatible Adapter 根据 Base URL 推导。
# dev launcher 会把 API Key 写入 .runtime/secrets/llm_api_key。
AIMA_LLM_BASE_URL=
AIMA_LLM_PROVIDER_NAME=
AIMA_LLM_MODEL=
AIMA_LLM_API_KEY=

# ------------------------------------------------------------
# Scheduler（可选）
# ------------------------------------------------------------
# 默认关闭，避免本地数据库中残留的 enabled Plan 在启动开发环境时意外产生付费采集。
# 需要调试周期采集计划时显式改为 true，然后重启 backend.py。
AIMA_DEV_ENABLE_SCHEDULER=false
